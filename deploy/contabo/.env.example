# Sarfees API — Contabo production env template
#
# 1. Copy to `.env` (never commit .env — .gitignore already excludes it)
# 2. Fill DB_PASSWORD with a random 32+ char string
# 3. Run `bash scripts/gen-secrets.sh` to fill the JWT_* rows
# 4. Point the app-init version fields at real store URLs when ready

# ─── Database ──────────────────────────────────────────────────
DB_USERNAME=sarfees_user
DB_PASSWORD=CHANGE_ME_TO_RANDOM_STRONG_STRING
DB_NAME=sarfees_db
DB_PORT=5432  # only exposed inside the docker network; host does not see it

# ─── JWT secrets (all filled by scripts/gen-secrets.sh) ────────
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_DRIVER_ACCESS_SECRET=
JWT_DRIVER_REFRESH_SECRET=
JWT_ADMIN_ACCESS_SECRET=
JWT_ADMIN_REFRESH_SECRET=

# ─── Suspension policy thresholds (home-summary.suspensionInfo) ─
DRIVER_MIN_RATING=4.0
DRIVER_REVIEW_MIN_DAYS=1
DRIVER_REVIEW_MAX_DAYS=3

# ─── Support contacts (shown in suspensionInfo + app-init) ─────
SUPPORT_EMAIL=support@sarfees.com
SUPPORT_PHONE=

# ─── Admin portal CORS (comma-separated origins) ───────────────
ADMIN_PORTAL_ORIGIN=https://admin.sarfees.com

# ─── App-init version gate (per platform) ──────────────────────
IOS_LATEST_VERSION=1.0.0
IOS_MIN_VERSION=1.0.0
IOS_STORE_URL=https://apps.apple.com/app/idPLACEHOLDER
ANDROID_LATEST_VERSION=1.0.0
ANDROID_MIN_VERSION=1.0.0
ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=PLACEHOLDER

# ─── Legal ─────────────────────────────────────────────────────
TERMS_URL=https://sarfees.com/legal/terms
PRIVACY_URL=https://sarfees.com/legal/privacy

# ─── Feature flags ─────────────────────────────────────────────
MAINTENANCE_MODE=false
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,ar
MATCHING_ENABLED=true
