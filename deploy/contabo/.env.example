# Sarfees API — Contabo production env template
#
# 1. Copy to `.env` (never commit .env — .gitignore already excludes it)
# 2. Fill DB_PASSWORD with a random 32+ char string
# 3. Run `bash scripts/gen-secrets.sh` to fill the JWT_* rows
# 4. Point the app-init version fields at real store URLs when ready

# ─── Database ──────────────────────────────────────────────────
DB_USERNAME=sarfees_user
DB_PASSWORD=CHANGE_ME_TO_RANDOM_STRONG_STRING
DB_NAME=sarfees_db
DB_PORT=5432  # only exposed inside the docker network; host does not see it

# ─── JWT secrets (all filled by scripts/gen-secrets.sh) ────────
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_DRIVER_ACCESS_SECRET=
JWT_DRIVER_REFRESH_SECRET=
JWT_ADMIN_ACCESS_SECRET=
JWT_ADMIN_REFRESH_SECRET=
# Admin portal session length. Access cookie in docker-compose.yml
# (ADMIN_ACCESS_TTL_SECONDS) must match JWT_ADMIN_ACCESS_EXPIRES_IN.
JWT_ADMIN_ACCESS_EXPIRES_IN=24h
JWT_ADMIN_REFRESH_EXPIRES_IN=7d

# ─── Suspension policy thresholds (home-summary.suspensionInfo) ─
DRIVER_MIN_RATING=4.0
DRIVER_REVIEW_MIN_DAYS=1
DRIVER_REVIEW_MAX_DAYS=3

# ─── Support contacts (shown in suspensionInfo + app-init) ─────
SUPPORT_EMAIL=support@sarfees.com
SUPPORT_PHONE=

# ─── Admin portal CORS (comma-separated origins) ───────────────
ADMIN_PORTAL_ORIGIN=https://admin.sarfees.com

# ─── Admin portal container ────────────────────────────────────
# Signs the httpOnly admin-session cookie. Generate with
#   openssl rand -hex 32
# Filled by scripts/gen-secrets.sh alongside the JWT secrets.
ADMIN_SESSION_SECRET=

# ─── App-init version gate (per platform) ──────────────────────
IOS_LATEST_VERSION=1.0.0
IOS_MIN_VERSION=1.0.0
IOS_STORE_URL=https://apps.apple.com/app/idPLACEHOLDER
ANDROID_LATEST_VERSION=1.0.0
ANDROID_MIN_VERSION=1.0.0
ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=PLACEHOLDER

# ─── Legal ─────────────────────────────────────────────────────
TERMS_URL=https://sarfees.com/legal/terms
PRIVACY_URL=https://sarfees.com/legal/privacy

# ─── Feature flags ─────────────────────────────────────────────
MAINTENANCE_MODE=false
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,ar
MATCHING_ENABLED=true

# ─── Map provider (three options; osrm is the recommended prod default) ─
#   osrm      — self-hosted road routing (this repo ships a docker
#               profile; run bash scripts/osrm-prepare.sh first).
#               Zero per-request cost, ~500 MB RAM footprint on the
#               VPS. No signup, no card.
#   mapbox    — paid road routing via api.mapbox.com. Needs a token
#               and (as of Jul 2026) a card on file for the free tier.
#   haversine — in-process straight-line math. Zero cost, less accurate.
MAP_PROVIDER=osrm
OSRM_BASE_URL=http://osrm:5000     # container hostname when both run in the same compose network
# MAPBOX_ACCESS_TOKEN=             # only set when MAP_PROVIDER=mapbox
MAPBOX_BASE_URL=https://api.mapbox.com
MAP_CACHE_MAX_ENTRIES=10000
MAP_CACHE_TTL_HOURS=24
# MAP_PROVIDER_FALLBACK controls behavior when the primary provider errors:
#   'haversine' (default) → retry with straight-line math
#   'reject'              → matcher rejects the eval
MAP_PROVIDER_FALLBACK=haversine

# ─── Matching engine thresholds (§14 of the master spec) ───────
MATCHING_MAX_GROUP_SIZE=4
MATCHING_SERVICE_RADIUS_METERS=5000
MATCHING_DETOUR_BOUND_PERCENT=20
MATCHING_MIXED_PASSENGER_MIN=2
MATCHING_MIXED_PASSENGER_MAX=3
MATCHING_MIXED_PACKAGE_MIN=3
MATCHING_MIXED_PACKAGE_MAX=5
MATCHING_PACKAGES_ONLY_MIN=7
MATCHING_PACKAGES_ONLY_MAX=15
MATCHING_SLOT_S=1
MATCHING_SLOT_M=2
MATCHING_SLOT_L=3
MATCHING_PASSENGER_WAIT_TOLERANCE_MIN=30
MATCHING_PACKAGE_WAIT_TOLERANCE_MIN=30
MATCHING_HANDLING_SEC_PER_PACKAGE=300
MATCHING_OFFER_COUNTDOWN_SEC=30
MATCHING_DRIVER_SEARCH_LEAD_MIN=30
MATCHING_NOW_WINDOW_MIN_MIN=15
MATCHING_NOW_WINDOW_MAX_MIN=30
MATCHING_SWEEP_INTERVAL_SEC=30
MATCHING_URGENT_EARLY_BROADCAST_DECLINES=3
MATCHING_BROADCAST_TRIGGER_DECLINE_COUNT=5
MATCHING_DECLINE_PENALTY_BASE=10
MATCHING_DECLINE_PENALTY_DECAY_DAYS=7
MATCHING_DRIVER_CANCEL_PENALTY=15
MATCHING_RECIPIENT_GRACE_MIN=10
MATCHING_SENDER_NOSHOW_GRACE_MIN=7
MATCHING_ASSIGNED_DRIVER_OFFLINE_GRACE_MIN=5
MATCHING_CANCELLATION_FEE_JOD_CENTS=200
MATCHING_NO_SHOW_FEE_JOD_CENTS=300
MATCHING_RETURN_REDELIVERY_FEE_JOD_CENTS=500
MATCHING_FULL_CAR_DISCOUNT_PERCENT=10
MATCHING_GOING_HOME_DAY_BOUNDARY_HOUR=0

# ─── Vehicle-class capacity defaults (seeded to vehicle_class_capacity) ─
VEHICLE_CAP_SEDAN_TRUNK_SLOTS=6
VEHICLE_CAP_SEDAN_WEIGHT_KG=50
VEHICLE_CAP_SEDAN_SEAT_SLOT=2
VEHICLE_CAP_SUV_TRUNK_SLOTS=9
VEHICLE_CAP_SUV_WEIGHT_KG=90
VEHICLE_CAP_SUV_SEAT_SLOT=3
VEHICLE_CAP_PICKUP_TRUNK_SLOTS=15
VEHICLE_CAP_PICKUP_WEIGHT_KG=200
VEHICLE_CAP_PICKUP_SEAT_SLOT=3

# --- Driver wallet (prepaid commission) -----------------------
# Seeded into wallet_config on first boot; runtime edits from the
# admin portal survive redeploys.
WALLET_COMMISSION_PERCENT=15
WALLET_LOW_BALANCE_THRESHOLD_JOD=5
WALLET_LOW_BALANCE_NOTIFY_COOLDOWN_HOURS=24
