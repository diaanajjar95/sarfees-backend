# Sarfees — Caddy reverse proxy config (no-domain mode)
#
# Current setup: no DNS names yet. Caddy binds to raw ports so ops
# can hit the box by IP:
#
#   http://<vps-ip>/              → NestJS API      (proxies :3000)
#   http://<vps-ip>:8080/         → Admin portal    (proxies :3001)
#
# When you register domains and DNS resolves to this box, replace the
# `:80` / `:8080` site blocks below with the two named ones at the
# bottom of this file — Caddy will fetch Let's Encrypt certs on first
# request and swap the app to HTTPS with no code change.

# ─── API on port 80 (no domain) ───────────────────────────────────
:80 {
	encode gzip
	request_body {
		max_size 15MB
	}
	# Public marketing page — served by the admin-portal container's
	# static bundle (public/landing/), auth-exempt in its middleware.
	# Temporary home until the landing page moves to its own project.
	# Anonymous package tracking page (receiver WhatsApp links).
	handle /track/* {
		reverse_proxy admin-portal:3001 {
			transport http {
				read_timeout 60s
				write_timeout 60s
			}
		}
	}
	handle /landing* {
		reverse_proxy admin-portal:3001 {
			transport http {
				read_timeout 60s
				write_timeout 60s
			}
		}
	}
	handle {
		reverse_proxy api:3000 {
			transport http {
				read_timeout 60s
				write_timeout 60s
			}
		}
	}
	log {
		output file /data/access-api.log {
			roll_size 100MB
			roll_keep 10
		}
	}
}

# ─── Admin portal on port 8080 (no domain) ────────────────────────
:8080 {
	encode gzip
	# The admin portal's server routes proxy /api/* to the backend
	# container over the internal docker network — no split needed
	# here.
	reverse_proxy admin-portal:3001 {
		transport http {
			read_timeout 60s
			write_timeout 60s
		}
	}
	log {
		output file /data/access-admin.log {
			roll_size 100MB
			roll_keep 10
		}
	}
}

# ─── Named-domain blocks (swap in once DNS is live) ───────────────
#
# api.sarfees.com {
# 	encode gzip
# 	request_body { max_size 15MB }
# 	reverse_proxy api:3000 {
# 		transport http {
# 			read_timeout 60s
# 			write_timeout 60s
# 		}
# 	}
# 	log { output file /data/access-api.log }
# }
#
# admin.sarfees.com {
# 	encode gzip
# 	reverse_proxy admin-portal:3001
# 	log { output file /data/access-admin.log }
# }
