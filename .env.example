# Sarfees API — local dev env template
#
# Copy to `.env` (already in .gitignore). Fill DB_* to point at your
# local docker Postgres, then `npm run start:dev`.

# ─── Database (point at your local docker postgres) ────────────
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=sarfees_user
DB_PASSWORD=devsecret
DB_NAME=sarfees_db
DB_SSL=false

# ─── JWT secrets (generate any random 48-byte base64 strings) ──
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_DRIVER_ACCESS_SECRET=
JWT_DRIVER_REFRESH_SECRET=
JWT_ADMIN_ACCESS_SECRET=
JWT_ADMIN_REFRESH_SECRET=

# ─── Map provider ──────────────────────────────────────────────
# Three options, all pluggable via the MapProvider interface:
#   haversine — in-process straight-line math, no dependency (default)
#   osrm      — self-hosted road routing, free forever, no signup
#               (bash scripts/osrm-prepare.sh + `docker compose
#               --profile osrm up -d osrm`)
#   mapbox    — paid road routing via the Mapbox API (needs a token)
MAP_PROVIDER=haversine
# OSRM_BASE_URL=http://localhost:5000
# MAPBOX_ACCESS_TOKEN=
MAPBOX_BASE_URL=https://api.mapbox.com
MAP_CACHE_MAX_ENTRIES=10000
MAP_CACHE_TTL_HOURS=24
MAP_PROVIDER_FALLBACK=haversine

# ─── Matching engine thresholds (§14 of the master spec) ───────
MATCHING_MAX_GROUP_SIZE=4
MATCHING_SERVICE_RADIUS_METERS=5000
MATCHING_DETOUR_BOUND_PERCENT=20
MATCHING_MIXED_PASSENGER_MIN=2
MATCHING_MIXED_PASSENGER_MAX=3
MATCHING_MIXED_PACKAGE_MIN=3
MATCHING_MIXED_PACKAGE_MAX=5
MATCHING_PACKAGES_ONLY_MIN=7
MATCHING_PACKAGES_ONLY_MAX=15
MATCHING_SLOT_S=1
MATCHING_SLOT_M=2
MATCHING_SLOT_L=3
MATCHING_PASSENGER_WAIT_TOLERANCE_MIN=30
MATCHING_PACKAGE_WAIT_TOLERANCE_MIN=30
MATCHING_HANDLING_SEC_PER_PACKAGE=300
MATCHING_OFFER_COUNTDOWN_SEC=30
MATCHING_DRIVER_SEARCH_LEAD_MIN=30
MATCHING_NOW_WINDOW_MIN_MIN=15
MATCHING_NOW_WINDOW_MAX_MIN=30
MATCHING_SWEEP_INTERVAL_SEC=30
MATCHING_URGENT_EARLY_BROADCAST_DECLINES=3
MATCHING_BROADCAST_TRIGGER_DECLINE_COUNT=5
MATCHING_DECLINE_PENALTY_BASE=10
MATCHING_DECLINE_PENALTY_DECAY_DAYS=7
MATCHING_DRIVER_CANCEL_PENALTY=15
MATCHING_RECIPIENT_GRACE_MIN=10
MATCHING_SENDER_NOSHOW_GRACE_MIN=7
MATCHING_ASSIGNED_DRIVER_OFFLINE_GRACE_MIN=5
MATCHING_CANCELLATION_FEE_JOD_CENTS=200
MATCHING_NO_SHOW_FEE_JOD_CENTS=300
MATCHING_RETURN_REDELIVERY_FEE_JOD_CENTS=500
MATCHING_FULL_CAR_DISCOUNT_PERCENT=10
MATCHING_GOING_HOME_DAY_BOUNDARY_HOUR=0

# ─── Vehicle-class capacity defaults (seeded to vehicle_class_capacity) ─
VEHICLE_CAP_SEDAN_TRUNK_SLOTS=6
VEHICLE_CAP_SEDAN_WEIGHT_KG=50
VEHICLE_CAP_SEDAN_SEAT_SLOT=2
VEHICLE_CAP_SUV_TRUNK_SLOTS=9
VEHICLE_CAP_SUV_WEIGHT_KG=90
VEHICLE_CAP_SUV_SEAT_SLOT=3
VEHICLE_CAP_PICKUP_TRUNK_SLOTS=15
VEHICLE_CAP_PICKUP_WEIGHT_KG=200
VEHICLE_CAP_PICKUP_SEAT_SLOT=3

# ─── Other services (see deploy/contabo/.env.example for full list) ─
SUPPORT_EMAIL=support@sarfees.com

# --- Driver wallet (prepaid commission) -----------------------
# Seeded into wallet_config on first boot; runtime edits from the
# admin portal survive redeploys.
WALLET_COMMISSION_PERCENT=15
WALLET_LOW_BALANCE_THRESHOLD_JOD=5
WALLET_LOW_BALANCE_NOTIFY_COOLDOWN_HOURS=24
