# Sarfees admin portal — environment template
# Copy to .env.local and adjust if needed.

# Backend base URL (NestJS API)
SARFEES_API_URL=http://localhost:3000

# Cookie secret used to sign httpOnly session cookies (rotate in production)
SESSION_SECRET=admin-portal-dev-secret-do-not-use-in-prod

# Cookie TTLs in seconds. Defaults are conservative (30m / 7d) — bump for dev.
# 2592000 = 30 days. Must mirror JWT_ADMIN_ACCESS_EXPIRES_IN /
# JWT_ADMIN_REFRESH_EXPIRES_IN on the backend so cookie + JWT expire together.
ADMIN_ACCESS_TTL_SECONDS=2592000
ADMIN_REFRESH_TTL_SECONDS=2592000
