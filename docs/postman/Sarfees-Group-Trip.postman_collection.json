    {
      "name": "4. Matching — wait for the group offer",
      "item": [
        {
          "name": "4.1 Poll driver home-summary → pendingOffer (re-run until pass)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{driverToken}}"
              }
            ],
            "url": "{{baseUrl}}/drivers/home-summary",
            "description": "Freeze happens when the shared departure crosses T-30 (~2 min after booking), then the cascade offers the trip. RE-RUN every ~30 s until the test passes. The offer has a 30 s countdown — accept promptly once it appears."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json().data ?? pm.response.json();",
                  "const offer = d.pendingOffer;",
                  "if (offer) {",
                  "  pm.collectionVariables.set('driverTripId', offer.tripId ?? offer.id);",
                  "  console.log('Offer! DriverTrip', offer.tripId, '—', offer.secondsRemaining, 's left. Run 4.2 then 5.1 NOW.');",
                  "} else {",
                  "  console.log('No offer yet — group freezes at T-30, sweeper ticks every 30 s. Re-run.');",
                  "}",
                  "pm.test('pendingOffer present (re-run until it passes)', () => pm.expect(offer, 'pendingOffer').to.exist);"
                ]
              }
            }
          ]
        },
        {
          "name": "4.2 Offer details — passenger count shows the bundle",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{driverToken}}"
              }
            ],
            "url": "{{baseUrl}}/drivers/trips/{{driverTripId}}/offer"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json().data ?? pm.response.json();",
                  "console.log('Offer summary:', JSON.stringify(d).slice(0, 400));",
                  "pm.test('offer returned', () => pm.response.to.be.success);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5. Assign — accept, PROOF of grouping",
      "item": [
        {
          "name": "5.1 Accept → manifest must contain all 3 passengers",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{driverToken}}"
              }
            ],
            "url": "{{baseUrl}}/drivers/trips/{{driverTripId}}/accept"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json().data ?? pm.response.json();",
                  "const stops = (d.stops || []).sort((a, b) => a.order - b.order);",
                  "pm.collectionVariables.set('stopsJson', JSON.stringify(stops));",
                  "pm.test('GROUPING PROOF: 3 passengers on one trip', () =>",
                  "  pm.expect(d.summary.passengerCount, 'summary.passengerCount').to.eql(3));",
                  "pm.test('multi-stop itinerary (>= 2 pickups + dropoffs)', () =>",
                  "  pm.expect(stops.length, 'stop count').to.be.at.least(2));",
                  "// Wire every stop into its own request pair (folder 6). Slots",
                  "// beyond the real stop count are blanked so they self-skip.",
                  "for (let i = 0; i < 6; i++) {",
                  "  const s = stops[i];",
                  "  if (!s) {",
                  "    pm.collectionVariables.set(`stop${i}Id`, '');",
                  "    pm.collectionVariables.set(`stop${i}Confirm`, '');",
                  "    pm.collectionVariables.set(`stop${i}Body`, '{}');",
                  "    continue;",
                  "  }",
                  "  pm.collectionVariables.set(`stop${i}Id`, String(s.id));",
                  "  if (s.type === 'pickup') {",
                  "    pm.collectionVariables.set(`stop${i}Confirm`, 'confirm-pickup');",
                  "    pm.collectionVariables.set(`stop${i}Body`, JSON.stringify({",
                  "      passengersPickedUp: s.passengers.map(p => p.id),",
                  "      noShows: [],",
                  "    }));",
                  "  } else {",
                  "    pm.collectionVariables.set(`stop${i}Confirm`, 'confirm-dropoff');",
                  "    pm.collectionVariables.set(`stop${i}Body`, JSON.stringify({",
                  "      passengersDroppedOff: s.passengers.map(p => ({ id: p.id, cashCollected: true })),",
                  "      packagesDelivered: [],",
                  "    }));",
                  "  }",
                  "}",
                  "console.log('Itinerary (' + stops.length + ' stops):');",
                  "stops.forEach((s, i) => console.log('  Stop ' + (i + 1) + ': #' + s.id + ' ' + s.type + ' @ ' + s.lat + ',' + s.lng + ' — ' + s.passengers.map(p => p.name).join(', ')));",
                  "console.log('Folder 6 is now fully wired — run it top to bottom.');"
                ]
              }
            }
          ]
        },
        {
          "name": "5.2 Passenger A sees the assigned driver",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{passengerAToken}}"
              }
            ],
            "url": "{{baseUrl}}/trips/{{requestAId}}/status"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json().data ?? pm.response.json();",
                  "pm.test('A has a driver', () => pm.expect(d.driver, 'driver').to.exist);",
                  "console.log('A driver:', d.driver && d.driver.name);"
                ]
              }
            }
          ]
        },
        {
          "name": "5.3 Passenger B sees the SAME driver",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{passengerBToken}}"
              }
