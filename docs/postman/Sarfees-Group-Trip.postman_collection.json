    {
      "name": "3. Passengers book — same corridor, same departure",
      "item": [
        {
          "name": "3.1 Passenger A books (creates the group, T+32 min)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{passengerAToken}}"
              }
            ],
            "url": "{{baseUrl}}/trips/request",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"departureCityId\": 2,\n  \"arrivalCityId\": 1,\n  \"departureLocation\": { \"lat\": 32.5810, \"lng\": 35.8660 },\n  \"arrivalLocation\": { \"lat\": 31.9612, \"lng\": 35.8776 },\n  \"travelDate\": \"{{groupTravelDate}}\",\n  \"seatsCount\": 1\n}"
            },
            "description": "Departs at the next quarter-hour ≥ 31 min out: the group is born OPEN and stays joinable until T-30. Run 3.2 and 3.3 immediately after. Pickups are in north Irbid, right where the demo driver’s phone is."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Next quarter-hour (:00/:15/:30/:45) that is at least 31 min out —",
                  "// satisfies both server rules: min 30-min lead + quarter-hour grid.",
                  "const t = new Date(Date.now() + 31 * 60 * 1000);",
                  "t.setUTCSeconds(0, 0);",
                  "const rem = t.getUTCMinutes() % 15;",
                  "if (rem !== 0) t.setUTCMinutes(t.getUTCMinutes() + (15 - rem));",
                  "const dep = t.toISOString();",
                  "pm.collectionVariables.set('groupTravelDate', dep);",
                  "console.log('Group departure set to', dep, '— B and C reuse it. Freeze fires at T-30 (up to ~15 min from now, depending on how the quarter-hour falls).');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json().data ?? pm.response.json();",
                  "pm.collectionVariables.set('requestAId', d.id);",
                  "pm.test('A request created', () => pm.expect(d.id).to.exist);",
                  "console.log('Request A =', d.id, '— now run 3.2 and 3.3 quickly.');"
                ]
              }
            }
          ]
        },
        {
          "name": "3.2 Passenger B joins (nearby pickup, same time)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{passengerBToken}}"
              }
            ],
            "url": "{{baseUrl}}/trips/request",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"departureCityId\": 2,\n  \"arrivalCityId\": 1,\n  \"departureLocation\": { \"lat\": 32.5790, \"lng\": 35.8680 },\n  \"arrivalLocation\": { \"lat\": 31.9560, \"lng\": 35.8850 },\n  \"travelDate\": \"{{groupTravelDate}}\",\n  \"seatsCount\": 1\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json().data ?? pm.response.json();",
                  "pm.collectionVariables.set('requestBId', d.id);",
                  "pm.test('B request created', () => pm.expect(d.id).to.exist);"
                ]
              }
            }
          ]
        },
        {
          "name": "3.3 Passenger C joins (nearby pickup, same time)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{passengerCToken}}"
              }
            ],
            "url": "{{baseUrl}}/trips/request",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"departureCityId\": 2,\n  \"arrivalCityId\": 1,\n  \"departureLocation\": { \"lat\": 32.5820, \"lng\": 35.8640 },\n  \"arrivalLocation\": { \"lat\": 31.9530, \"lng\": 35.8900 },\n  \"travelDate\": \"{{groupTravelDate}}\",\n  \"seatsCount\": 1\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json().data ?? pm.response.json();",
                  "pm.collectionVariables.set('requestCId', d.id);",
                  "pm.test('C request created', () => pm.expect(d.id).to.exist);",
                  "console.log('All three requests in. Freeze + driver search fires when departure crosses T-30 (~2 min). Then poll 4.1.');"
                ]
              }
            }
          ]
        }
      ]
