    {
      "name": "2. §7 guards — both rejections",
      "item": [
        {
          "name": "2.1 Male passenger books women-only → 403 (expected!)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{malePaxToken}}" }
            ],
            "url": "{{baseUrl}}/trips/request",
            "body": { "mode": "raw", "raw": "{\n  \"departureCityId\": 1,\n  \"arrivalCityId\": 2,\n  \"departureLocation\": { \"lat\": 31.9539, \"lng\": 35.9106 },\n  \"arrivalLocation\": { \"lat\": 32.5556, \"lng\": 35.8500 },\n  \"travelDate\": \"{{slot}}\",\n  \"isImmediate\": false,\n  \"seatsCount\": 1,\n  \"isFemaleOnly\": true\n}" },
            "description": "Green test = the API refused. A male passenger can never book a women-only trip."
          },
          "event": [
            { "listen": "prerequest", "script": { "type": "text/javascript", "exec": [
              "const t = new Date(Date.now() + 31 * 60 * 1000);",
              "t.setUTCSeconds(0, 0);",
              "const rem = t.getUTCMinutes() % 15;",
              "if (rem !== 0) t.setUTCMinutes(t.getUTCMinutes() + (15 - rem));",
              "pm.collectionVariables.set('slot', t.toISOString().replace(/\\.\\d{3}Z$/, '.000Z'));",
              "pm.collectionVariables.set('slot2', new Date(t.getTime() + 15 * 60 * 1000).toISOString().replace(/\\.\\d{3}Z$/, '.000Z'));",
              "console.log('Slot =', pm.collectionVariables.get('slot'), '— freeze fires at slot − 30 min.');"
            ] } },
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('male + women-only rejected with 403', () => pm.response.to.have.status(403));"] } }
          ]
        },
        {
          "name": "2.2 Male driver activates as women-only → 403 (expected!)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{maleDriverToken}}" }
            ],
            "url": "{{baseUrl}}/drivers/activate",
            "body": { "mode": "raw", "raw": "{\n  \"tripTypes\": [\"women_only\"],\n  \"goingHome\": false,\n  \"destinationCity\": \"Irbid\",\n  \"minPassengers\": 1,\n  \"currentLocationLat\": 31.9539,\n  \"currentLocationLng\": 35.9106\n}" },
            "description": "Green test = the API refused. Only female drivers may register for women-only work."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('male driver + women_only rejected with 403', () => pm.response.to.have.status(403));"] } }]
        }
      ]
    },
    {
