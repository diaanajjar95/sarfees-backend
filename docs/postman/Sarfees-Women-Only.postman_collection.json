    {
      "name": "5. Match — female-first cascade",
      "item": [
        {
          "name": "5.1 Poll RANIA until offer (re-run every ~30 s)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{femaleDriverToken}}" }],
            "url": "{{baseUrl}}/drivers/home-summary",
            "description": "Freeze fires when the slot crosses T-30 (up to ~15 min after booking). RE-RUN until it passes. Offer countdown is 30 s — run 5.2 immediately."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const d = pm.response.json().data ?? pm.response.json();",
            "const offer = d.pendingOffer;",
            "if (offer) {",
            "  pm.collectionVariables.set('tripId', offer.tripId);",
            "  console.log('OFFER for Rania! trip', offer.tripId, '—', offer.secondsRemaining, 's left. Run 5.2 NOW.');",
            "} else {",
            "  console.log('No offer yet — re-run in ~30 s.');",
            "}",
            "pm.test('Rania has the offer (re-run until it passes)', () => pm.expect(offer, 'pendingOffer').to.exist);"
          ] } }]
        },
        {
          "name": "5.2 Rania accepts → trip type women_only",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{femaleDriverToken}}" }],
            "url": "{{baseUrl}}/drivers/trips/{{tripId}}/accept"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const d = pm.response.json().data ?? pm.response.json();",
            "pm.test('accepted', () => pm.expect(d.status).to.eql('accepted'));",
            "pm.test('trip is women_only', () => pm.expect(d.type).to.eql('women_only'));",
            "pm.test('two pickup stops — one per passenger', () => {",
            "  const pickups = (d.stops ?? []).filter(s => s.type === 'pickup');",
            "  pm.expect(pickups.length).to.eql(2);",
            "});"
          ] } }]
        },
        {
          "name": "5.3 Omar never saw the women-only trip",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{maleDriverToken}}" }],
            "url": "{{baseUrl}}/drivers/home-summary",
            "description": "Omar may legitimately hold an offer for the MALE group's trip — but never for the women-only one."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const d = pm.response.json().data ?? pm.response.json();",
            "const offer = d.pendingOffer;",
            "pm.test('no women-only offer for the male driver', () => {",
            "  if (!offer) return; // nothing pending at all — pass",
            "  pm.expect(offer.tripId, 'Omar was offered the women-only trip!').to.not.eql(Number(pm.collectionVariables.get('tripId')));",
            "});",
            "console.log(offer ? `Omar holds trip ${offer.tripId} (the regular group) — fine.` : 'Omar has no pending offer — fine.');"
          ] } }]
        }
      ]
    },
    {
      "name": "6. Cleanup — cancel + drivers offline",
      "item": [
        {
          "name": "6.1 Admin cancels the women-only trip",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": "{{baseUrl}}/admin/trips/{{tripId}}/cancel",
            "body": { "mode": "raw", "raw": "{\n  \"reason\": \"Postman women-only run — cleanup\"\n}" },
            "description": "Full-stop cancel: also cancels the two member requests, freeing both passengers."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('cancelled', () => pm.response.to.be.success);"] } }]
        },
        {
          "name": "6.2 Admin cancels the male's request",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": "{{baseUrl}}/admin/passenger-requests/{{maleRequestId}}/cancel",
            "body": { "mode": "raw", "raw": "{\n  \"reason\": \"Postman women-only run — cleanup\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('cancelled', () => pm.response.to.be.success);"] } }]
