            "url": "{{baseUrl}}/drivers/activate",
            "body": { "mode": "raw", "raw": "{\n  \"tripTypes\": [\"mixed\"],\n  \"goingHome\": false,\n  \"destinationCity\": \"Irbid\",\n  \"minPassengers\": 1,\n  \"currentLocationLat\": 31.9800,\n  \"currentLocationLng\": 35.9250\n}" }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
