          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('offline', () => pm.response.to.be.success);"] } }]
        },
        {
          "name": "6.4 Omar offline (skip folder 7) — or keep him on for the fallback test",
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{maleDriverToken}}" }], "url": "{{baseUrl}}/drivers/deactivate",
            "description": "Run this only if you are NOT continuing to folder 7 — the fallback test needs Omar online and Rania offline." },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('offline', () => pm.response.to.be.success);"] } }]
        }
      ]
    },
    {
      "name": "7. OPTIONAL — §9.4 male fallback",
      "description": "Prereq: Rania OFFLINE, Omar ONLINE (folder 6: run 6.3, skip 6.4 — or re-run 4.1). With no female driver available, the male driver is the legitimate last resort and passengers are notified with free cancel.",
      "item": [
        {
          "name": "7.1 Female A books women-only again",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{femaleAToken}}" }
            ],
            "url": "{{baseUrl}}/trips/request",
            "body": { "mode": "raw", "raw": "{\n  \"departureCityId\": 1,\n  \"arrivalCityId\": 2,\n  \"departureLocation\": { \"lat\": 31.9539, \"lng\": 35.9106 },\n  \"arrivalLocation\": { \"lat\": 32.5556, \"lng\": 35.8500 },\n  \"travelDate\": \"{{slot}}\",\n  \"isImmediate\": false,\n  \"seatsCount\": 1,\n  \"isFemaleOnly\": true\n}" }
          },
          "event": [
            { "listen": "prerequest", "script": { "type": "text/javascript", "exec": [
              "const t = new Date(Date.now() + 31 * 60 * 1000);",
              "t.setUTCSeconds(0, 0);",
              "const rem = t.getUTCMinutes() % 15;",
              "if (rem !== 0) t.setUTCMinutes(t.getUTCMinutes() + (15 - rem));",
              "pm.collectionVariables.set('slot', t.toISOString().replace(/\\.\\d{3}Z$/, '.000Z'));",
              "console.log('Fallback slot =', pm.collectionVariables.get('slot'));"
            ] } },
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('created', () => pm.response.to.have.status(201));"] } }
          ]
        },
        {
          "name": "7.2 Poll OMAR until fallback offer (re-run every ~30 s)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{maleDriverToken}}" }],
            "url": "{{baseUrl}}/drivers/home-summary",
            "description": "No female online → the cascade falls back to the male driver instead of escalating. RE-RUN until it passes; accept within 30 s."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const d = pm.response.json().data ?? pm.response.json();",
            "const offer = d.pendingOffer;",
            "if (offer) {",
            "  pm.collectionVariables.set('fallbackTripId', offer.tripId);",
            "  console.log('FALLBACK offer for Omar! trip', offer.tripId, '. Run 7.3 NOW.');",
            "} else {",
            "  console.log('No offer yet — re-run in ~30 s.');",
            "}",
            "pm.test('Omar has the fallback offer (re-run until it passes)', () => pm.expect(offer, 'pendingOffer').to.exist);"
          ] } }]
        },
        {
          "name": "7.3 Omar accepts the women-only trip",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{maleDriverToken}}" }],
            "url": "{{baseUrl}}/drivers/trips/{{fallbackTripId}}/accept"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const d = pm.response.json().data ?? pm.response.json();",
            "pm.test('accepted', () => pm.expect(d.status).to.eql('accepted'));",
            "pm.test('trip is women_only', () => pm.expect(d.type).to.eql('women_only'));"
          ] } }]
        },
        {
          "name": "7.4 Passenger got the free-cancel fallback notification",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{femaleAToken}}" }],
            "url": "{{baseUrl}}/users/notifications?limit=5"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const body = pm.response.json().data ?? pm.response.json();",
            "const rows = Array.isArray(body) ? body : (body.data ?? body.notifications ?? []);",
            "pm.test('women_only_male_driver_fallback notification present', () => {",
            "  pm.expect(rows.some(n => n.type === 'women_only_male_driver_fallback')).to.be.true;",
            "});"
          ] } }]
        },
        {
          "name": "7.5 Cleanup — cancel fallback trip + Omar offline",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": "{{baseUrl}}/admin/trips/{{fallbackTripId}}/cancel",
            "body": { "mode": "raw", "raw": "{\n  \"reason\": \"Postman women-only fallback run — cleanup\"\n}" },
            "description": "After this, run 6.4 to take Omar offline."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('cancelled', () => pm.response.to.be.success);"] } }]
        }
      ]
    }
  ]
}
