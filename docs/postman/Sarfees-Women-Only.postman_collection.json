          "name": "3.2 Female B — women-only at slot, ~500 m away",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{femaleBToken}}" }
            ],
            "url": "{{baseUrl}}/trips/request",
            "body": { "mode": "raw", "raw": "{\n  \"departureCityId\": 1,\n  \"arrivalCityId\": 2,\n  \"departureLocation\": { \"lat\": 31.9560, \"lng\": 35.9130 },\n  \"arrivalLocation\": { \"lat\": 32.5530, \"lng\": 35.8530 },\n  \"travelDate\": \"{{slot}}\",\n  \"isImmediate\": false,\n  \"seatsCount\": 1,\n  \"isFemaleOnly\": true\n}" }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('created', () => pm.response.to.have.status(201));"] } }]
        },
        {
          "name": "3.3 Male — REGULAR request, same corridor + slot",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{malePaxToken}}" }
            ],
            "url": "{{baseUrl}}/trips/request",
            "body": { "mode": "raw", "raw": "{\n  \"departureCityId\": 1,\n  \"arrivalCityId\": 2,\n  \"departureLocation\": { \"lat\": 31.9550, \"lng\": 35.9120 },\n  \"arrivalLocation\": { \"lat\": 32.5556, \"lng\": 35.8500 },\n  \"travelDate\": \"{{slot}}\",\n  \"isImmediate\": false,\n  \"seatsCount\": 1,\n  \"isFemaleOnly\": false\n}" },
            "description": "Identical corridor, identical slot, pickup between the two women — must still land in a separate group."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const d = pm.response.json().data ?? pm.response.json();",
            "pm.collectionVariables.set('maleRequestId', d.id);",
            "pm.test('created', () => pm.response.to.have.status(201));"
          ] } }]
        },
        {
          "name": "3.4 ISOLATION PROOF — one womenOnly group of 2, male separate",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/admin/trip-groups?limit=10",
            "description": "The women-only pair must share one womenOnly group; the male's request must sit in its own non-women-only group despite the identical corridor and slot."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const d = pm.response.json().data ?? pm.response.json();",
            "const rows = d.data ?? d;",
            "const open = rows.filter(g => g.status === 'open');",
            "const wo = open.filter(g => g.womenOnly);",
            "const reg = open.filter(g => !g.womenOnly);",
            "pm.test('exactly one open women-only group', () => pm.expect(wo.length).to.eql(1));",
            "pm.test('women-only group holds both women', () => {",
            "  const members = wo[0].memberCount ?? wo[0].passengerCount ?? wo[0].members;",
            "  pm.expect(Number(members)).to.eql(2);",
            "});",
            "pm.test('male request is in a separate regular group', () => pm.expect(reg.length).to.be.at.least(1));",
            "pm.collectionVariables.set('womenOnlyGroupId', wo[0].id);",
            "console.log('women-only group', wo[0].id, '| regular group(s)', reg.map(g => g.id).join(','));"
          ] } }]
        }
      ]
    },
